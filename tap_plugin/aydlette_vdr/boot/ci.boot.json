{
  "version": 1,
  "description": "aydlette_vdr CI record (req-boot-bootstrap-ci-record): the stack this plugin's own tests run in. The install set is the depends_on closure (compliance_core, computing_core through fedramp_20x_vdr, fedramp_20x_vdr) at the versions it was tested against, plus aydlette_vdr itself as an editable checkout (it has no published release). Population seeds fedramp_20x_vdr's timeframe rows and the starter profile. Excluded: every other plugin, all credentials, and any step that reaches the network.",
  "install": {
    "plugins": [
      {
        "slug": "compliance_core",
        "enabled": true,
        "source": {
          "type": "git",
          "url": "https://github.com/unified-systems-com/compliance-core-tap",
          "rev": "v0.8.13",
          "commit": "4169092e43aeb60ab23919688890318b584ea1a0"
        }
      },
      {
        "slug": "computing_core",
        "enabled": true,
        "source": {
          "type": "git",
          "url": "https://github.com/unified-systems-com/computing-core-tap",
          "rev": "v0.10.9",
          "commit": "9995fe301e27ea41e7fe1faae93bfc1f1291371e"
        }
      },
      {
        "slug": "fedramp_20x_vdr",
        "enabled": true,
        "source": {
          "type": "git",
          "url": "https://github.com/unified-systems-com/fedramp-20x-vdr-tap",
          "rev": "v0.1.6",
          "commit": "6472dfd784d19da28f749534fcb20bbf4ab47960"
        }
      },
      {
        "slug": "aydlette_vdr",
        "enabled": true,
        "source": {
          "type": "editable",
          "path": "_dev-plugins/aydlette_vdr"
        }
      }
    ]
  },
  "population": {
    "on_failure": "abort",
    "steps": [
      {
        "type": "seed-plugin",
        "plugin": "fedramp_20x_vdr",
        "enabled": true,
        "note": "The timeframe rows the clock reads."
      },
      {
        "type": "seed-plugin",
        "plugin": "aydlette_vdr",
        "enabled": true,
        "note": "Own GRIFT: the aydlette-starter profile."
      }
    ]
  }
}
